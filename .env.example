# Copy to .env.local for local development, and set the same variables in the Vercel project
# (diesis-site → Settings → Environment Variables) for production. Only the feedback form uses them.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address. Must be on a domain verified in Resend (diesis.app under Resend → Domains,
# with the DNS records it gives you added at Namecheap). Cannot be a Gmail address.
FEEDBACK_FROM_EMAIL="Diesis <feedback@diesis.app>"

# Where feedback is delivered. Kept out of the code because the repo is public.
FEEDBACK_TO_EMAIL=
