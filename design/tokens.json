{
  "$comment": "Diesis design tokens. Colors are sRGB hex. Sizes are points (native) / CSS px (web). Source of truth for src/ui/theme.ts.",
  "color": {
    "stage": {
      "background": "#14120f",
      "surface": "#23201b",
      "surfaceRaised": "#2e2a24",
      "border": "#3a352d",
      "ink": "#f3efe6",
      "muted": "#a39c8e",
      "accent": "#e0a63a",
      "accentText": "#f0c46a",
      "correct": "#4caf6b",
      "wrong": "#d64545"
    },
    "fretboard": {
      "wood": "#5a3a2b",
      "woodEdge": "#3d271c",
      "fret": "#c9c6bd",
      "fretShadow": "#7d7a72",
      "nut": "#e9e2cf",
      "string": "#d8d4c8",
      "stringShadow": "#6b6558",
      "inlay": "#e8e2d3",
      "fretNumber": "#a39c8e",
      "highlight": "#e0a63a",
      "highlightCorrect": "#4caf6b",
      "highlightInk": "#14120f"
    }
  },
  "type": {
    "family": "system",
    "styles": {
      "title":      { "size": 18, "line": 22, "weight": 600 },
      "noteButton": { "size": 22, "line": 26, "weight": 600 },
      "feedback":   { "size": 22, "line": 28, "weight": 600 },
      "score":      { "size": 15, "line": 20, "weight": 400, "color": "muted" },
      "fretNumber": { "size": 12, "line": 14, "weight": 400, "color": "fretNumber" },
      "noteOnBoard":{ "size": 14, "line": 16, "weight": 700 }
    }
  },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 24 },
  "radius": { "s": 8, "m": 12, "pill": 999 },
  "fretboard": {
    "stringGauges": [1.2, 1.5, 1.9, 2.4, 3.0, 3.6],
    "inlayFrets": [3, 5, 7, 9, 12, 15, 17, 19, 21, 24],
    "doubleInlayFrets": [12, 24]
  }
}
