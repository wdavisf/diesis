---
import Logo from './Logo.astro';
import { strings, PLAY_URL, type Lang } from '../i18n';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const t = strings[lang];
const home = t.base || '/';
const p = (hash: string) => `${t.base}/${hash}`.replace('//', '/');
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap footer-inner">
    <div class="footer-brand">
      <Logo size={30} />
      <div>
        <strong>Diesis</strong>
        <p>{t.footer.tagline}</p>
      </div>
    </div>
    <nav aria-label="Footer">
      <a href={PLAY_URL}>{t.nav.cta}</a>
      <a href={`${home}#how`.replace('//', '/')}>{t.nav.how}</a>
      <a href={`${home}#modes`.replace('//', '/')}>{t.nav.modes}</a>
      <a href={`${home}#faq`.replace('//', '/')}>{t.nav.faq}</a>
      <a href={p('privacy')}>{t.nav.privacy}</a>
      <a href={t.otherLang === 'es' ? '/es' : '/'} hreflang={t.otherLang} lang={t.otherLang}>{t.otherLang === 'es' ? 'Español' : 'English'}</a>
    </nav>
  </div>
  <div class="wrap footer-legal">
    <p>© {year} Diesis. {t.footer.made}</p>
    <p>{t.footer.trademarks}</p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding: 48px 0 40px; }
  .footer-inner { display: flex; justify-content: space-between; gap: 32px; flex-wrap: wrap; }
  .footer-brand { display: flex; gap: 14px; align-items: flex-start; max-width: 380px; }
  .footer-brand strong { display: block; font-size: 18px; margin-bottom: 4px; }
  .footer-brand p { color: var(--muted); font-size: 15px; }
  nav { display: flex; gap: 20px; flex-wrap: wrap; align-items: center; }
  nav a { color: var(--ink); font-weight: 600; font-size: 15px; }
  .footer-legal { margin-top: 36px; color: var(--muted); font-size: 13px; display: grid; gap: 6px; }
</style>
