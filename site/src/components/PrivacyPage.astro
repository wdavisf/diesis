---
import Base from '../layouts/Base.astro';
import { strings, CONTACT, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const p = t.privacy;
---
<Base title={t.meta.privacyTitle} description={t.meta.privacyDescription} lang={lang}>
  <article class="section policy">
    <div class="wrap">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1>{p.h1}</h1>
      <p class="updated">{p.updated}</p>

      <div class="summary card">
        <p><strong>{p.summary}</strong></p>
      </div>

      {p.sections.map((s) => (
        <>
          <h2>{s.h}</h2>
          {s.p.map((para) => <p>{para}</p>)}
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
        </>
      ))}

      <h2>{p.contactHeading}</h2>
      <p>{p.contact} <a href={`mailto:${CONTACT}`}>{CONTACT}</a></p>
    </div>
  </article>
</Base>

<style>
  .policy .wrap { max-width: 760px; }
  h1 { font-size: clamp(32px, 5vw, 44px); }
  .updated { color: var(--muted); margin-top: 10px; font-size: 15px; }
  .summary { margin: 32px 0; padding: 22px 24px; }
  .summary strong { color: var(--ink); font-weight: 600; }
  h2 { font-size: 22px; margin: 36px 0 10px; }
  p, li { color: var(--muted); }
  p + p { margin-top: 12px; }
  ul { padding-left: 20px; margin: 0; display: grid; gap: 6px; }
</style>
